# ============================================================
# SorghumCare (BimaSorgum) — template variabel lingkungan
# ============================================================
# CARA PAKAI:
#   1. Salin file ini menjadi  .env   (tanpa "example"):
#        cp .env.example .env
#   2. Isi nilainya. Tanpa VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY,
#      aplikasi akan langsung error saat dibuka (lihat src/lib/supabase.ts).
#
# JANGAN pernah commit file .env. Yang di-commit hanya file ini (.env.example),
# dan hanya berisi placeholder — bukan key asli.
# ============================================================


# ---------- WAJIB: dibaca BROWSER (prefix VITE_ ter-bundle ke JS) ----------

# URL project Supabase. Contoh: https://abcdefghijklm.supabase.co
# Dashboard Supabase -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=

# Key publik Supabase untuk klien (aman ter-bundle: akses datanya dibatasi RLS).
# Utamakan PUBLISHABLE key (sb_publishable_...) bila project Anda sudah
# mendukungnya; key anon legacy (eyJ...) juga masih jalan.
# Dashboard Supabase -> Project Settings -> API -> anon / publishable key
VITE_SUPABASE_ANON_KEY=


# ---------- WAJIB: HANYA dibaca SERVER (proxy Vite, TANPA prefix VITE_) ----------

# Consumer key backend AI BIMA. Formatnya bima_live_xxxxxxxx.
# Dibuat di dashboard backend RAG -> halaman "API Consumers"
# (POST /api/consumers). Lihat SETUP-LOKAL.md bagian 4.
#
# JANGAN pernah menulis ini sebagai VITE_BIMA_API_KEY: prefix VITE_ membuat
# Vite menyalin nilainya ke bundle browser dan key Anda ikut bocor ke publik.
# Nama tanpa prefix dibaca vite.config.ts di sisi server saja.
BIMA_API_KEY=


# ---------- OPSIONAL ----------

# Origin backend AI. Kosongkan untuk memakai default.
# Default: https://api.llmsorgum.online
BIMA_BACKEND_ORIGIN=

# Access key Unsplash untuk gambar resep (dipakai src/data/imageAssets.ts).
# Opsional — tanpa ini gambar tetap tampil dari URL statis; key ini hanya
# menaikkan kuota/rate limit Unsplash. Dapatkan di https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=


# ---------- JANGAN DIPAKAI (sisa jalur lama, ter-bundle ke browser) ----------
# src/services/bimaClient.ts masih membaca dua variabel ini. Biarkan KOSONG:
# keduanya berprefix VITE_ sehingga nilainya masuk ke JavaScript yang dikirim
# ke browser. Backend hanya butuh BIMA_API_KEY di sisi proxy.
# VITE_BIMA_API_KEY=
# VITE_BIMA_MODEL=
